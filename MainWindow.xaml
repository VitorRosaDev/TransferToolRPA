<Window x:Class="TransferToolRPA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransferToolRPA"
        mc:Ignorable="d"
        Title="TransferTool RPA - Controle de Transferências" 
        Height="500" Width="850"
        Background="#000000"
        WindowStartupLocation="CenterScreen"
        Foreground="#E7E9EA">

    <Window.Resources>
        <!-- Paleta de Cores Alinhada com o Tema Escuro do Mobile -->
        <SolidColorBrush x:Key="BgBrush" Color="#000000"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#16181C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2F3336"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E7E9EA"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#71767A"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#00BA7C"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F4212E"/>

        <!-- Estilo Base para os Botões com o Template do WPF -->
        <Style x:Key="BaseRpaButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1C1E22"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para o Botão Iniciar (Azul Royal) -->
        <Style x:Key="IniciarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseRpaButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Estilo para o Botão Cancelar (Vermelho Perigo) -->
        <Style x:Key="CancelarButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseRpaButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Estilo para os itens do ListBox (removendo azul padrão de seleção) -->
        <Style x:Key="RpaListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#202329"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#252932"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para o botão de lixeira (Trash Button) -->
        <Style x:Key="TrashButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71767A"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#331A1C"/>
                                <Setter Property="Foreground" Value="#F4212E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4C1F22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Cabecalho -->
            <RowDefinition Height="*" MinHeight="195"/> <!-- Row 1: Área Central (Editável) -->
            <RowDefinition Height="Auto"/> <!-- Row 2: Divisor de Arrastar (GridSplitter) -->
            <RowDefinition Height="*" MinHeight="100"/> <!-- Row 3: Logs de Execução -->
            <RowDefinition Height="Auto"/> <!-- Row 4: Barra de Progresso (Base) -->
        </Grid.RowDefinitions>

        <!-- Cabeçalho Principal -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="TransferTool RPA" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Automação DOM integrada com Atende.Net | Almoxarifado Central" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="🌐 Abrir Chrome" 
                    Command="{Binding AbrirNavegadorCommand}"
                    Style="{StaticResource IniciarButtonStyle}"
                    Width="160"
                    Height="40"
                    FontSize="13"
                    VerticalAlignment="Center"
                    ToolTip="Abre o navegador isolado com depuração na porta 9222"/>
        </Grid>

        <!-- Área Central (Upload e Dados de Carga) -->
        <Grid Grid.Row="1" Margin="0,0,0,15" MinHeight="195">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Zona de Drag and Drop -->
            <Border x:Name="UploadBorder"
                    Grid.Column="0" 
                    Background="{StaticResource CardBgBrush}" 
                    BorderBrush="{StaticResource PrimaryBrush}" 
                    BorderThickness="1.5" 
                    CornerRadius="8" 
                    Margin="0,0,15,0"
                    AllowDrop="True"
                    DragEnter="Border_DragEnter"
                    DragLeave="Border_DragLeave"
                    Drop="Border_Drop"
                    Cursor="Hand"
                    MouseDown="Border_MouseDown">
                
                <Grid AllowDrop="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel AllowDrop="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📥" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Arraste o arquivo JSON da carga aqui" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ou clique para navegar no computador" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Painel de Fila de Cargas Importadas -->
            <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Título -->
                        <RowDefinition Height="*"/>    <!-- ListBox Scrollável -->
                        <RowDefinition Height="Auto"/> <!-- Separador -->
                        <RowDefinition Height="Auto"/> <!-- Ações -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CARGAS IMPORTADAS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                    
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding CargasImportadas}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch"
                             Margin="0,0,0,10"
                             ItemContainerStyle="{StaticResource RpaListBoxItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="5,8"
                                        Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding codigo_destino, StringFormat='Destino: {0}'}" 
                                                       FontWeight="Bold" 
                                                       FontSize="13" 
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding itens.Length, StringFormat={}{0} itens cadastrados}" 
                                                       FontSize="11" 
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" 
                                                Content="🗑️" 
                                                Command="{Binding DataContext.ExcluirCargaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TrashButtonStyle}"
                                                ToolTip="Excluir carga da fila"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator Grid.Row="2" Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>

                    <!-- Ações de Automação -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" 
                                Content="Iniciar RPA" 
                                Command="{Binding IniciarAutomacaoCommand}"
                                Style="{StaticResource IniciarButtonStyle}"
                                Margin="0,0,5,0"/>

                        <Button Grid.Column="1" 
                                Content="Cancelar" 
                                Command="{Binding CancelarAutomacaoCommand}"
                                Style="{StaticResource CancelarButtonStyle}"
                                Margin="5,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Divisor para redimensionamento vertical da Área Central -->
        <GridSplitter Grid.Row="2" 
                      Height="5" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Center" 
                      Background="{StaticResource BorderBrush}" 
                      ShowsPreview="True" 
                      Margin="0,0,0,15"
                      Cursor="SizeNS"/>

        <!-- Logs de Execução em tempo real (Achatado e Compactado) -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="LOG DE EXECUÇÃO EM TEMPO REAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,5"/>
            
            <Border Grid.Row="1" Background="#070707" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBox x:Name="TxtLog"
                         Text="{Binding LogOutput, Mode=OneWay}"
                         Background="Transparent"
                         Foreground="#A3E4D7"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="10"
                         TextChanged="TxtLog_TextChanged"/>
            </Border>
        </Grid>

        <!-- Barra de Progresso Visual (Posicionada na Base) -->
        <Border Grid.Row="4" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="15">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding ProgressoMensagem}" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding ProgressoPercent, StringFormat={}{0:0}%}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Height="10" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="{Binding ProgressoPercent}" 
                             Foreground="{StaticResource PrimaryBrush}" 
                             Background="#050505"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
